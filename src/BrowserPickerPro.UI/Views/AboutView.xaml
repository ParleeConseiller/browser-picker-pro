<Page x:Class="BrowserPickerPro.UI.Views.AboutView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:BrowserPickerPro.UI.ViewModels"
      mc:Ignorable="d" Background="Transparent"
      d:DataContext="{d:DesignInstance vm:AboutViewModel}">

    <Grid Margin="32,24">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">

            <!-- App Identity Card -->
            <Border CornerRadius="16" Padding="28" Margin="0,0,0,20"
                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource Theme.Surface}" Offset="0"/>
                        <GradientStop Color="{DynamicResource Theme.Surface2}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="16" Opacity="0.1" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="72" Height="72" CornerRadius="18"
                            Margin="0,0,20,0" VerticalAlignment="Top">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0078D4" Offset="0"/>
                                <GradientStop Color="#FF00BCF2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🌐" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppName}"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <TextBlock Text="{Binding Tagline}"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Margin="0,4,0,8"/>
                        <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.Surface3}">
                            <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Credits -->
            <Border Style="{StaticResource Card.Default}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Credits" Style="{StaticResource TextStyle.Subtitle}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Created by" Style="{StaticResource TextStyle.BodySecondary}"/>
                        <TextBlock Text="{Binding Company}" HorizontalAlignment="Right"
                                   Style="{StaticResource TextStyle.Body}" FontWeight="Medium"/>
                    </Grid>
                    <Separator Style="{StaticResource Separator.Subtle}"/>
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="Main Developer" Style="{StaticResource TextStyle.BodySecondary}"/>
                        <TextBlock Text="{Binding Developer}" HorizontalAlignment="Right"
                                   Style="{StaticResource TextStyle.Body}" FontWeight="Medium"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- System Info -->
            <Border Style="{StaticResource Card.Default}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="System Information" Style="{StaticResource TextStyle.Subtitle}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Framework" Style="{StaticResource TextStyle.BodySecondary}"/>
                        <TextBlock Text="{Binding Framework}" HorizontalAlignment="Right"
                                   Style="{StaticResource TextStyle.Caption}"
                                   FontFamily="{StaticResource Font.Mono}"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Platform" Style="{StaticResource TextStyle.BodySecondary}"/>
                        <TextBlock Text="{Binding Platform}" HorizontalAlignment="Right"
                                   Style="{StaticResource TextStyle.Caption}"
                                   FontFamily="{StaticResource Font.Mono}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Copyright -->
            <TextBlock Text="{Binding Copyright}" Style="{StaticResource TextStyle.Caption}"
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <!-- Links -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenGitHubCommand}"
                        Margin="0,0,8,0">
                    <TextBlock Text="GitHub" Style="{StaticResource TextStyle.Body}"
                               Foreground="{DynamicResource Brush.Accent}"/>
                </Button>
                <TextBlock Text="·" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource Brush.TextTertiary}"/>
                <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenLicenseCommand}">
                    <TextBlock Text="MIT License" Style="{StaticResource TextStyle.Body}"
                               Foreground="{DynamicResource Brush.Accent}"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
