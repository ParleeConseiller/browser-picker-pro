<Page x:Class="BrowserPickerPro.UI.Views.SetupView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:BrowserPickerPro.UI.ViewModels"
      mc:Ignorable="d" Background="Transparent"
      d:DataContext="{d:DesignInstance vm:SetupWizardViewModel}">

    <StackPanel Margin="32,24" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="Windows Setup" Style="{StaticResource TextStyle.TitleLarge}"/>
        <TextBlock Text="Register Browser Picker Pro as your default browser handler on Windows."
                   Style="{StaticResource TextStyle.BodySecondary}" Margin="0,4,0,24"/>

        <!-- Status Card -->
        <Border CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1A30D158"/>
                    <Setter Property="BorderBrush" Value="#4030D158"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRegistered}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="20">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="✓"/>
                            <Setter Property="Foreground" Value="#FF30D158"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegistered}" Value="False">
                                    <Setter Property="Text" Value="ℹ"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextStyle.Body}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Steps -->
        <Border Style="{StaticResource Card.Default}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="How to set Browser Picker Pro as your default browser:"
                           Style="{StaticResource TextStyle.Body}" FontWeight="SemiBold" Margin="0,0,0,14"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Brush.Accent}"
                            Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="1" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock TextWrapping="Wrap" MaxWidth="460" Style="{StaticResource TextStyle.Body}">
                        <Run Text="Click "/>
                        <Run Text="Register as Browser" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <Run Text=" below to register Browser Picker Pro with Windows."/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Brush.Accent}"
                            Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="2" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock TextWrapping="Wrap" MaxWidth="460" Style="{StaticResource TextStyle.Body}">
                        <Run Text="Click "/>
                        <Run Text="Open Default Apps" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <Run Text=" to open Windows Settings."/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Brush.Accent}"
                            Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Text="3" Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock TextWrapping="Wrap" MaxWidth="460" Style="{StaticResource TextStyle.Body}"
                               Text='Search for "Browser Picker Pro" and select it as default for HTTP, HTTPS, and HTML files.'/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Style="{StaticResource Button.Primary}" Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7B5;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Register as Browser" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenDefaultAppsCommand}"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Open Default Apps" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Button.Ghost}" Command="{Binding UnregisterCommand}"
                    Visibility="{Binding IsRegistered, Converter={StaticResource BoolToVisibility}}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                <TextBlock Text="Unregister" Foreground="{DynamicResource Brush.TextTertiary}"/>
            </Button>
        </StackPanel>

        <!-- Warning -->
        <Border CornerRadius="8" Padding="12,10" Background="#1AFF9F0A" BorderBrush="#33FF9F0A" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="14" Margin="0,0,8,0" Foreground="#FFFF9F0A" VerticalAlignment="Top"/>
                <TextBlock TextWrapping="Wrap" MaxWidth="520"
                           Style="{StaticResource TextStyle.Caption}">
                    Due to Windows security restrictions, you must manually select Browser Picker Pro in Default Apps Settings.
                    The Register button prepares the registry entries; Windows requires the final step to be done manually.
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
