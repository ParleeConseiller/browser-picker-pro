<Page x:Class="BrowserPickerPro.UI.Views.BrowsersView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:BrowserPickerPro.UI.ViewModels"
      mc:Ignorable="d" Background="Transparent"
      d:DataContext="{d:DesignInstance vm:BrowsersViewModel}">

    <Grid Margin="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Installed Browsers" Style="{StaticResource TextStyle.TitleLarge}"/>
                <TextBlock Text="Manage which browsers appear in the picker and how they are displayed."
                           Style="{StaticResource TextStyle.BodySecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="12,8" CornerRadius="8"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextStyle.Caption}"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>
        </Border>

        <!-- Loading -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Detecting installed browsers..."
                       Style="{StaticResource TextStyle.BodySecondary}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Browser List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Browsers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" CornerRadius="12"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                BorderThickness="1" Padding="16,14">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="8" Opacity="0.06" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                        Background="{DynamicResource Brush.Surface2}">
                                    <Image Source="{Binding Icon}" Stretch="Uniform" Margin="6"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource TextStyle.Body}" FontWeight="SemiBold"/>
                                        <Border Margin="8,0,0,0" CornerRadius="4" Padding="6,1"
                                                Background="{DynamicResource Brush.Surface2}"
                                                Visibility="{Binding ProfileCount, Converter={StaticResource NullToVisibility}, Mode=OneWay}">
                                            <TextBlock FontSize="10" FontFamily="{StaticResource Font.Primary}"
                                                       Foreground="{DynamicResource Brush.TextTertiary}">
                                                <Run Text="{Binding ProfileCount, Mode=OneWay}"/>
                                                <Run Text="profiles"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                                               Style="{StaticResource TextStyle.Caption}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding ExecutablePath}"
                                               Style="{StaticResource TextStyle.Caption}"
                                               Foreground="{DynamicResource Brush.TextTertiary}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="380" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- Status badge -->
                                <Border Grid.Column="2" CornerRadius="6" Padding="8,4" Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A30D158"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                    <Setter Property="Background" Value="#1AFF453A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontFamily="{StaticResource Font.Primary}" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Installed"/>
                                                <Setter Property="Foreground" Value="#FF30D158"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                        <Setter Property="Text" Value="Not Found"/>
                                                        <Setter Property="Foreground" Value="#FFFF453A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- Toggle -->
                                <ToggleButton Grid.Column="3" Style="{StaticResource ToggleButton.Switch}"
                                              IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                              ToolTip="Enable/disable this browser in the picker"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Padding="0,12,0,0"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Style="{StaticResource TextStyle.Caption}"
                           Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center">
                    <Run Text="Press F5 to refresh · Changes are saved automatically"/>
                </TextBlock>
                <Button Content="Save Changes" Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Right" Command="{Binding SaveCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Page>
