<Page x:Class="BrowserPickerPro.UI.Views.AppearanceView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:BrowserPickerPro.UI.ViewModels"
      mc:Ignorable="d" Background="Transparent"
      d:DataContext="{d:DesignInstance vm:AppearanceViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" MaxWidth="680" HorizontalAlignment="Left">

            <TextBlock Text="Appearance" Style="{StaticResource TextStyle.TitleLarge}"/>
            <TextBlock Text="Customize the look and feel of Browser Picker Pro."
                       Style="{StaticResource TextStyle.BodySecondary}" Margin="0,4,0,24"/>

            <!-- Theme -->
            <Border Style="{StaticResource Card.Default}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Color Theme" Style="{StaticResource TextStyle.Body}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="System" GroupName="Theme" Margin="0,0,16,0"
                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBool}, ConverterParameter=System}"
                                     FontFamily="{StaticResource Font.Primary}" Cursor="Hand"/>
                        <RadioButton Content="Light" GroupName="Theme" Margin="0,0,16,0"
                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBool}, ConverterParameter=Light}"
                                     FontFamily="{StaticResource Font.Primary}" Cursor="Hand"/>
                        <RadioButton Content="Dark" GroupName="Theme"
                                     IsChecked="{Binding SelectedTheme, Converter={StaticResource EnumToBool}, ConverterParameter=Dark}"
                                     FontFamily="{StaticResource Font.Primary}" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Effects -->
            <Border Style="{StaticResource Card.Default}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Window Effects" Style="{StaticResource TextStyle.Body}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Mica background effect" Style="{StaticResource TextStyle.Body}"/>
                            <TextBlock Text="Applies a frosted glass effect using the Windows 11 Mica material."
                                       Style="{StaticResource TextStyle.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton HorizontalAlignment="Right" Style="{StaticResource ToggleButton.Switch}"
                                      IsChecked="{Binding EnableMicaEffect}" VerticalAlignment="Top"/>
                    </Grid>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Smooth animations" Style="{StaticResource TextStyle.Body}"/>
                            <TextBlock Text="Enable hover and transition animations throughout the app."
                                       Style="{StaticResource TextStyle.Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ToggleButton HorizontalAlignment="Right" Style="{StaticResource ToggleButton.Switch}"
                                      IsChecked="{Binding EnableAnimations}" VerticalAlignment="Top"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Picker Settings -->
            <Border Style="{StaticResource Card.Default}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Browser Picker" Style="{StaticResource TextStyle.Body}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Show browser version" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                        <ToggleButton HorizontalAlignment="Right" Style="{StaticResource ToggleButton.Switch}"
                                      IsChecked="{Binding ShowBrowserVersion}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Show recent usage indicators" Style="{StaticResource TextStyle.Body}" VerticalAlignment="Center"/>
                        <ToggleButton HorizontalAlignment="Right" Style="{StaticResource ToggleButton.Switch}"
                                      IsChecked="{Binding ShowRecentUsage}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Picker Window Style -->
            <Border Style="{StaticResource Card.Default}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Picker Window Style" Style="{StaticResource TextStyle.Body}" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <!-- Window mode -->
                    <TextBlock Text="Window mode" Style="{StaticResource TextStyle.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="Modal (floating)" GroupName="PickerWindowStyle" Margin="0,0,20,0"
                                     IsChecked="{Binding PickerWindowStyle, Converter={StaticResource EnumToBool}, ConverterParameter=Modal}"
                                     FontFamily="{StaticResource Font.Primary}" Cursor="Hand"/>
                        <RadioButton Content="Fullscreen overlay" GroupName="PickerWindowStyle"
                                     IsChecked="{Binding PickerWindowStyle, Converter={StaticResource EnumToBool}, ConverterParameter=Fullscreen}"
                                     FontFamily="{StaticResource Font.Primary}" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Card layout -->
                    <TextBlock Text="Card layout" Style="{StaticResource TextStyle.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton Content="Wrap grid" GroupName="PickerCardLayout" Margin="0,0,20,0"
                                     IsChecked="{Binding PickerCardLayout, Converter={StaticResource EnumToBool}, ConverterParameter=WrapGrid}"
                                     FontFamily="{StaticResource Font.Primary}" Cursor="Hand"/>
                        <RadioButton Content="Single row" GroupName="PickerCardLayout"
                                     IsChecked="{Binding PickerCardLayout, Converter={StaticResource EnumToBool}, ConverterParameter=SingleRow}"
                                     FontFamily="{StaticResource Font.Primary}" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Background mode -->
                    <TextBlock Text="Background" Style="{StaticResource TextStyle.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <RadioButton Content="Dark gradient" GroupName="PickerBgMode" Margin="0,0,20,0"
                                     IsChecked="{Binding PickerBackgroundMode, Converter={StaticResource EnumToBool}, ConverterParameter=DarkGradient}"
                                     FontFamily="{StaticResource Font.Primary}" Cursor="Hand"/>
                        <RadioButton Content="Custom file (image / GIF / video)" GroupName="PickerBgMode"
                                     IsChecked="{Binding PickerBackgroundMode, Converter={StaticResource EnumToBool}, ConverterParameter=CustomFile}"
                                     FontFamily="{StaticResource Font.Primary}" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Custom file picker -->
                    <Grid Margin="0,0,0,16"
                          Visibility="{Binding IsCustomFileMode, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource TextBox.Modern}"
                                 Text="{Binding PickerBackgroundImagePath, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Browse…" Style="{StaticResource Button.Secondary}"
                                Command="{Binding BrowseBackgroundCommand}"/>
                    </Grid>

                    <!-- Dark tint slider -->
                    <TextBlock Style="{StaticResource TextStyle.Body}" Margin="0,0,0,4">
                        <Run Text="Dark tint: "/>
                        <Run Text="{Binding PickerDarkTintPercent, Mode=OneWay, StringFormat=\{0\}%}"/>
                    </TextBlock>
                    <Slider Minimum="0" Maximum="90" Value="{Binding PickerDarkTintPercent}"
                            TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,16"/>

                    <!-- Card size slider -->
                    <TextBlock Style="{StaticResource TextStyle.Body}" Margin="0,0,0,4">
                        <Run Text="Card size: "/>
                        <Run Text="{Binding PickerCardSize, Mode=OneWay, StringFormat=\{0\} px}"/>
                    </TextBlock>
                    <Slider Minimum="140" Maximum="260" Value="{Binding PickerCardSize}"
                            TickFrequency="10" IsSnapToTickEnabled="True"/>
                </StackPanel>
            </Border>

            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextStyle.BodySecondary}"
                           Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center"
                           Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}"/>
                <Button Content="Save Appearance" Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Right" Command="{Binding SaveCommand}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
