<Page x:Class="BrowserPickerPro.UI.Views.ImportExportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:BrowserPickerPro.UI.ViewModels"
      mc:Ignorable="d" Background="Transparent"
      d:DataContext="{d:DesignInstance vm:ImportExportViewModel}">

    <StackPanel Margin="32,24" MaxWidth="600" HorizontalAlignment="Left">
        <TextBlock Text="Import / Export" Style="{StaticResource TextStyle.TitleLarge}"/>
        <TextBlock Text="Back up or restore your Browser Picker Pro configuration."
                   Style="{StaticResource TextStyle.BodySecondary}" Margin="0,4,0,24"/>

        <!-- Export -->
        <Border Style="{StaticResource Card.Default}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource Brush.Accent}"/>
                    <TextBlock Text="Export Configuration" Style="{StaticResource TextStyle.Subtitle}"/>
                </StackPanel>
                <TextBlock Text="Save your settings, browser list, and rules to a JSON file."
                           Style="{StaticResource TextStyle.BodySecondary}" Margin="0,0,0,14"/>
                <Button Content="Export to JSON..." Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Left" Command="{Binding ExportCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            </StackPanel>
        </Border>

        <!-- Import -->
        <Border Style="{StaticResource Card.Default}" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource Brush.Accent}"/>
                    <TextBlock Text="Import Configuration" Style="{StaticResource TextStyle.Subtitle}"/>
                </StackPanel>
                <TextBlock Text="Restore settings from a previously exported JSON file. This will overwrite your current configuration."
                           Style="{StaticResource TextStyle.BodySecondary}" Margin="0,0,0,14" TextWrapping="Wrap"/>
                <Button Content="Import from JSON..." Style="{StaticResource Button.Secondary}"
                        HorizontalAlignment="Left" Command="{Binding ImportCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            </StackPanel>
        </Border>

        <!-- App Data Folder -->
        <Border Style="{StaticResource Card.Default}" Margin="0,0,0,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <TextBlock Text="App Data Folder" Style="{StaticResource TextStyle.Subtitle}"/>
                </StackPanel>
                <TextBlock Text="Open the folder where Browser Picker Pro stores its configuration files."
                           Style="{StaticResource TextStyle.BodySecondary}" Margin="0,0,0,14"/>
                <Button Content="Open in Explorer" Style="{StaticResource Button.Ghost}"
                        HorizontalAlignment="Left" Command="{Binding OpenAppDataFolderCommand}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextStyle.BodySecondary}"
                   Foreground="{DynamicResource Brush.Success}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}"/>
    </StackPanel>
</Page>
