<Window x:Class="BrowserPickerPro.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BrowserPickerPro.UI.ViewModels"
        xmlns:views="clr-namespace:BrowserPickerPro.UI.Views"
        mc:Ignorable="d"
        Title="Browser Picker Pro — Configuration"
        Width="960" Height="640"
        MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <Window.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Navigation"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="8,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.NavItemHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.NavItemActive}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" x:Name="TitleBarGrid">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <Image Source="/Assets/Icons/app.ico" Width="16" Height="16" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Browser Picker Pro" VerticalAlignment="Center"
                           Style="{StaticResource TextStyle.Body}" FontWeight="Medium"/>
                <TextBlock Text="— Configuration" VerticalAlignment="Center"
                           Style="{StaticResource TextStyle.BodySecondary}" Margin="4,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.TitleBar}" Click="MinimizeButton_Click" ToolTip="Minimize">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource Button.TitleBar}" Click="MaximizeButton_Click" ToolTip="Maximize">
                    <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                </Button>
                <Button Style="{StaticResource Button.TitleBarClose}" Click="CloseButton_Click" ToolTip="Close">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.SidebarBackground}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo Area -->
                    <StackPanel Grid.Row="0" Margin="16,20,16,16">
                        <TextBlock Text="Browser Picker Pro"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <TextBlock Text="Choose the right browser every time."
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel Grid.Row="1" Margin="0,4">

                        <TextBlock Text="MAIN" Margin="20,8,0,4"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="10" FontWeight="SemiBold"                                   Foreground="{DynamicResource Brush.TextTertiary}"/>

                        <RadioButton Style="{StaticResource NavItem}"
                                     x:Name="BrowsersNavItem"
                                     IsChecked="True"
                                     Click="NavItem_Click" Tag="Browsers">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Browsers" VerticalAlignment="Center"
                                           FontWeight="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}, Converter={x:Null}}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavItem}"
                                     Click="NavItem_Click" Tag="Rules">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70C;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Rules" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavItem}"
                                     Click="NavItem_Click" Tag="Security">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Security" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="SETTINGS" Margin="20,16,0,4"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="10" FontWeight="SemiBold"                                   Foreground="{DynamicResource Brush.TextTertiary}"/>

                        <RadioButton Style="{StaticResource NavItem}"
                                     Click="NavItem_Click" Tag="Appearance">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavItem}"
                                     Click="NavItem_Click" Tag="ImportExport">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Import / Export" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="SYSTEM" Margin="20,16,0,4"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="10" FontWeight="SemiBold"                                   Foreground="{DynamicResource Brush.TextTertiary}"/>

                        <RadioButton Style="{StaticResource NavItem}"
                                     Click="NavItem_Click" Tag="Setup">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B5;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Windows Setup" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavItem}"
                                     Click="NavItem_Click" Tag="About">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="About" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Version Footer -->
                    <Border Grid.Row="2" Padding="16,12"
                            BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0">
                        <TextBlock FontFamily="{StaticResource Font.Primary}" FontSize="10"
                                   Foreground="{DynamicResource Brush.TextTertiary}">
                            <Run Text="v1.0.0  ·  "/>
                            <Run Text="Parlee Conseiller, Inc."/>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- Content Frame -->
            <Frame Grid.Column="1" x:Name="ContentFrame"
                   NavigationUIVisibility="Hidden"
                   Background="Transparent"/>
        </Grid>
    </Grid>
</Window>
