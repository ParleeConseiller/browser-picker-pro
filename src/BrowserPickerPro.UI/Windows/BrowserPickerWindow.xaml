<Window x:Class="BrowserPickerPro.UI.Windows.BrowserPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BrowserPickerPro.UI.ViewModels"
        mc:Ignorable="d"
        Title="Browser Picker Pro"
        Width="720" Height="520"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        d:DataContext="{d:DesignInstance vm:BrowserPickerViewModel}">

    <Window.Resources>
        <Style x:Key="BrowserCardStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="154"/>
            <Setter Property="Height" Value="138"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="CardShadow"
                                                  ShadowDepth="0" BlurRadius="8"
                                                  Opacity="0.08" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Brush.Surface2}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.04" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.04" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardShadow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="20" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="CardShadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.18" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardShadow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="8" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="CardShadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.08" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.97" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.97" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text="🌐" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Browser Picker Pro" VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="13" FontWeight="Medium"
                           Foreground="{DynamicResource Brush.TextSecondary}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.TitleBar}" Click="MinimizeButton_Click" ToolTip="Minimize">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                </Button>
                <Button Style="{StaticResource Button.TitleBarClose}" Click="CloseButton_Click" ToolTip="Cancel">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- URL Bar -->
        <Border Grid.Row="1" Margin="20,4,20,12"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="10" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                           FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource Brush.TextTertiary}"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayUrl}"
                           FontFamily="{StaticResource Font.Mono}"
                           FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayUrl}"/>
            </Grid>
        </Border>

        <!-- Security Panel -->
        <Border Grid.Row="2" Margin="20,0,20,10"
                Visibility="{Binding ShowSecurityPanel, Converter={StaticResource BoolToVisibility}}">
            <Border x:Name="SecurityBanner" CornerRadius="8" Padding="12,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#1A30D158"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSecurityChecking}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SecurityResult.OverallLevel}" Value="Suspicious">
                                <Setter Property="Background" Value="#1AFF9F0A"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SecurityResult.OverallLevel}" Value="Dangerous">
                                <Setter Property="Background" Value="#1AFF453A"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14"
                               Visibility="{Binding IsSecurityChecking, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="Checking security..."/>
                    </TextBlock>
                    <StackPanel Visibility="{Binding IsSecurityChecking, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SecurityResult.OverallLevel, Converter={StaticResource SecurityLevelToIcon}}"
                                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{Binding SecurityResult.OverallLevel, Converter={StaticResource SecurityLevelToBrush}}"/>
                            <TextBlock FontFamily="{StaticResource Font.Primary}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}">
                                <Run Text="Security check: "/>
                                <Run Text="{Binding SecurityResult.OverallLevel, Mode=OneWay}" FontWeight="Medium"
                                     Foreground="{Binding SecurityResult.OverallLevel, Mode=OneWay, Converter={StaticResource SecurityLevelToBrush}}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Section Header -->
        <Grid Grid.Row="3" Margin="20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Open with..." Style="{StaticResource TextStyle.Subtitle}"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Style="{StaticResource TextBox.Modern}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="180" HorizontalAlignment="Right"
                         Tag="Search browsers...">
                    <TextBox.Resources>
                        <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Modern}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <Label Content="Search browsers..." Padding="10,0"
                                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                                           FontFamily="{StaticResource Font.Primary}"
                                                           FontSize="12"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </Grid>

            <!-- Loading -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Detecting browsers..." Style="{StaticResource TextStyle.BodySecondary}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Browser Grid -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Modern}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding FilteredBrowsers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BrowserCardStyle}"
                                    Command="{Binding DataContext.SelectBrowserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Tag="{Binding}"
                                    AllowDrop="True"
                                    PreviewMouseLeftButtonDown="BrowserCard_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="BrowserCard_PreviewMouseMove"
                                    DragOver="BrowserCard_DragOver"
                                    DragEnter="BrowserCard_DragEnter"
                                    DragLeave="BrowserCard_DragLeave"
                                    Drop="BrowserCard_Drop">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Browser Icon -->
                                    <Border Grid.Row="0" Width="52" Height="52" Margin="0,16,0,4"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- Browser Name -->
                                    <TextBlock Grid.Row="1" Text="{Binding DisplayName}"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource Font.Primary}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="130" Margin="8,2"/>

                                    <!-- Version -->
                                    <TextBlock Grid.Row="2" Text="{Binding ShortVersion, StringFormat='v{0}'}"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource Font.Primary}"
                                               FontSize="10"
                                               Foreground="{DynamicResource Brush.TextTertiary}"
                                               Margin="0,0,0,4"/>

                                    <!-- Usage Badge -->
                                    <Border Grid.Row="3" HorizontalAlignment="Center"
                                            CornerRadius="4" Padding="6,2" Margin="0,0,0,8"
                                            Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibility}}">
                                        <Border.Background>
                                            <SolidColorBrush Color="{DynamicResource Theme.Accent}" Opacity="0.15"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding UsageLabel}"
                                                   FontSize="9" FontFamily="{StaticResource Font.Primary}"
                                                   Foreground="{DynamicResource Brush.Accent}"/>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Remember Checkbox -->
        <Border Grid.Row="4" Margin="20,8,20,0" Padding="0,8,0,0"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0">
            <CheckBox Style="{StaticResource CheckBox.Modern}"
                      IsChecked="{Binding RememberChoice}"
                      Foreground="{DynamicResource Brush.TextSecondary}"
                      FontSize="12">
                <TextBlock Text="Remember for this domain" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}"/>
            </CheckBox>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="5" Margin="20,8,20,16">
            <Grid>
                <TextBlock Text="{Binding Domain, StringFormat='Domain: {0}'}"
                           Style="{StaticResource TextStyle.Caption}"
                           VerticalAlignment="Center"
                           Visibility="{Binding Domain, Converter={StaticResource StringToVisibility}}"/>
                <Button Content="Cancel" Style="{StaticResource Button.Secondary}"
                        HorizontalAlignment="Right"
                        Command="{Binding CancelCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
