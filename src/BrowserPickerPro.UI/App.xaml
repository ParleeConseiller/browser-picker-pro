<Application x:Class="BrowserPickerPro.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:BrowserPickerPro.UI.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <converters:EnumToBoolConverter x:Key="EnumToBool"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <converters:InverseBoolConverter x:Key="InverseBool"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <converters:SecurityLevelToBrushConverter x:Key="SecurityLevelToBrush"/>
            <converters:SecurityLevelToIconConverter x:Key="SecurityLevelToIcon"/>
            <converters:UsageCountToLabelConverter x:Key="UsageCountToLabel"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
