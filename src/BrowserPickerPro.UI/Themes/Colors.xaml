<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- === DARK THEME COLORS === -->
    <Color x:Key="Dark.Background">#FF1C1C1E</Color>
    <Color x:Key="Dark.Surface">#FF2C2C2E</Color>
    <Color x:Key="Dark.Surface2">#FF3A3A3C</Color>
    <Color x:Key="Dark.Surface3">#FF48484A</Color>
    <Color x:Key="Dark.Border">#FF48484A</Color>
    <Color x:Key="Dark.BorderSubtle">#FF3A3A3C</Color>
    <Color x:Key="Dark.TextPrimary">#FFFFFFFF</Color>
    <Color x:Key="Dark.TextSecondary">#99EBEBF5</Color>
    <Color x:Key="Dark.TextTertiary">#60EBEBF5</Color>
    <Color x:Key="Dark.Accent">#FF0078D4</Color>
    <Color x:Key="Dark.AccentHover">#FF1A88E0</Color>
    <Color x:Key="Dark.AccentPress">#FF006BBC</Color>
    <Color x:Key="Dark.Success">#FF30D158</Color>
    <Color x:Key="Dark.Warning">#FFFF9F0A</Color>
    <Color x:Key="Dark.Danger">#FFFF453A</Color>
    <Color x:Key="Dark.CardBackground">#FF2C2C2E</Color>
    <Color x:Key="Dark.CardHover">#FF3A3A3C</Color>
    <Color x:Key="Dark.CardPress">#FF48484A</Color>
    <Color x:Key="Dark.Overlay">#80000000</Color>
    <Color x:Key="Dark.Shadow">#CC000000</Color>
    <Color x:Key="Dark.SidebarBackground">#FF1C1C1E</Color>
    <Color x:Key="Dark.NavItemHover">#1AFFFFFF</Color>
    <Color x:Key="Dark.NavItemActive">#26FFFFFF</Color>

    <!-- === LIGHT THEME COLORS === -->
    <Color x:Key="Light.Background">#FFF2F2F7</Color>
    <Color x:Key="Light.Surface">#FFFFFFFF</Color>
    <Color x:Key="Light.Surface2">#FFF2F2F7</Color>
    <Color x:Key="Light.Surface3">#FFE5E5EA</Color>
    <Color x:Key="Light.Border">#FFC6C6C8</Color>
    <Color x:Key="Light.BorderSubtle">#FFD1D1D6</Color>
    <Color x:Key="Light.TextPrimary">#FF000000</Color>
    <Color x:Key="Light.TextSecondary">#993C3C43</Color>
    <Color x:Key="Light.TextTertiary">#603C3C43</Color>
    <Color x:Key="Light.Accent">#FF0078D4</Color>
    <Color x:Key="Light.AccentHover">#FF1A88E0</Color>
    <Color x:Key="Light.AccentPress">#FF006BBC</Color>
    <Color x:Key="Light.Success">#FF34C759</Color>
    <Color x:Key="Light.Warning">#FFFF9500</Color>
    <Color x:Key="Light.Danger">#FFFF3B30</Color>
    <Color x:Key="Light.CardBackground">#FFFFFFFF</Color>
    <Color x:Key="Light.CardHover">#FFF5F5F7</Color>
    <Color x:Key="Light.CardPress">#FFE5E5EA</Color>
    <Color x:Key="Light.Overlay">#40000000</Color>
    <Color x:Key="Light.Shadow">#28000000</Color>
    <Color x:Key="Light.SidebarBackground">#FFF2F2F7</Color>
    <Color x:Key="Light.NavItemHover">#14000000</Color>
    <Color x:Key="Light.NavItemActive">#20000000</Color>

    <!-- === SEMANTIC BRUSHES (will be overridden by theme) === -->
    <SolidColorBrush x:Key="Brush.Background" Color="{DynamicResource Theme.Background}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Theme.Surface}"/>
    <SolidColorBrush x:Key="Brush.Surface2" Color="{DynamicResource Theme.Surface2}"/>
    <SolidColorBrush x:Key="Brush.Surface3" Color="{DynamicResource Theme.Surface3}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Theme.Border}"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{DynamicResource Theme.BorderSubtle}"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{DynamicResource Theme.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{DynamicResource Theme.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{DynamicResource Theme.TextTertiary}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Theme.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{DynamicResource Theme.AccentHover}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Theme.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Theme.Warning}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Theme.Danger}"/>
    <SolidColorBrush x:Key="Brush.CardBackground" Color="{DynamicResource Theme.CardBackground}"/>
    <SolidColorBrush x:Key="Brush.NavItemHover" Color="{DynamicResource Theme.NavItemHover}"/>
    <SolidColorBrush x:Key="Brush.NavItemActive" Color="{DynamicResource Theme.NavItemActive}"/>
    <SolidColorBrush x:Key="Brush.SidebarBackground" Color="{DynamicResource Theme.SidebarBackground}"/>

    <!-- === TRANSPARENT === -->
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent"/>

</ResourceDictionary>
